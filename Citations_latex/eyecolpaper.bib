author = {Mark Simcoe  and Ana Valdes  and Fan Liu  and Nicholas A. Furlotte  and David M. Evans  and Gibran Hemani  and Susan M. Ring  and George Davey Smith  and David L. Duffy  and Gu Zhu  and Scott D. Gordon  and Sarah E. Medland  and Dragana Vuckovic  and Giorgia Girotto  and Cinzia Sala  and Eulalia Catamo  and Maria Pina Concas  and Marco Brumat  and Paolo Gasparini  and Daniela Toniolo  and Massimiliano Cocca  and Antonietta Robino  and Seyhan Yazar  and Alex Hewitt  and Wenting Wu  and Peter Kraft  and Christopher J. Hammond  and Yuan Shi  and Yan Chen  and Changqing Zeng  and Caroline C. W. Klaver  and Andre G. Uitterlinden  and M. Arfan Ikram  and Merel A. Hamer  and Cornelia M. van Duijn  and Tamar Nijsten  and Jiali Han  and David A. Mackey  and Nicholas G. Martin  and Ching-Yu Cheng  and the 23andMe Research Team and the International Visible Trait Genetics Consortium and David A. Hinds  and Timothy D. Spector  and Manfred Kayser  and Pirro G. Hysi },
title = {Genome-wide association study in almost 195,000 individuals identifies 50 previously unidentified genetic loci for eye color},
journal = {Science Advances},
volume = {7},
